# ══════════════════════════════════════════════════════════════
# immo-template — Variables d'environnement
# Copiez ce fichier en .env.local et renseignez les valeurs
# ══════════════════════════════════════════════════════════════

# ── Supabase (OBLIGATOIRE) ────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Site (OBLIGATOIRE en production) ──────────────────────────
# URL publique du site vitrine (sitemap, canonical, Open Graph).
# IMPORTANT : dans apps/admin/.env.local, cette variable DOIT pointer vers
# le site PUBLIC (apps/web) — pas vers le panel admin. Elle est utilisée
# par l'admin pour construire les liens dans les emails (alertes,
# désinscription) et pour invalider l'ISR du site public.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# URL du panel admin lui-même — utilisée uniquement pour les digests
# "action à faire" (lien de retour au dashboard). N'est requis que dans
# apps/admin/.env.local, pas dans apps/web.
# NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# ── Email — Resend (optionnel) ────────────────────────────────
# Sans cette clé, les formulaires fonctionnent mais aucun email n'est envoyé
RESEND_API_KEY=re_...

# ── ISR — Revalidation (optionnel) ────────────────────────────
# Secret partagé entre admin et web pour l'invalidation de cache on-demand
# Générez avec : openssl rand -base64 32
REVALIDATION_SECRET=

# ── Analytics — Plausible (optionnel, RGPD-friendly) ─────────
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
