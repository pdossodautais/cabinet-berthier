{
  "name": "immo-template",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "dev:web": "turbo dev --filter=@repo/web",
    "dev:admin": "turbo dev --filter=@repo/admin",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:admin": "playwright test --config=playwright.admin.config.ts",
    "setup:env": "node -e \"const fs=require('fs'),p=require('path');['apps/web','apps/admin'].forEach(d=>{const t=p.join(d,'.env.local');if(!fs.existsSync(t)){fs.symlinkSync('../../.env.local',t);console.log('Created symlink:',t)}else{console.log('Already exists:',t)}})\""
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "turbo": "^2",
    "vitest": "^4.1.4"
  },
  "overrides": {
    "picomatch": "^4.0.5"
  }
}
